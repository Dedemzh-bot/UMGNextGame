{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextgame.local/schemas/ui-agent-findings-0.1.json",
  "title": "NextGame UI AgentFindings",
  "type": "object",
  "required": ["version", "requestId", "agentRole", "inputDigest", "sourceScope", "findings", "evidence", "questionCandidates"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "0.1"},
    "requestId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "agentRole": {
      "enum": [
        "visual-structure",
        "text-requirements",
        "project-pattern",
        "state-modeling",
        "data-adaptation",
        "asset-decomposition",
        "state-visual-review",
        "schema-feasibility-review",
        "coverage-review"
      ]
    },
    "inputDigest": {"$ref": "#/$defs/sha256"},
    "contextDigest": {"$ref": "#/$defs/sha256"},
    "sourceScope": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^source-[a-z0-9][a-z0-9-]*$"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "questionCandidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "localId": {"type": "string", "pattern": "^local-[a-z0-9][a-z0-9-]*$"},
    "localRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/localId"}
    },
    "bounds": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "pixelBounds": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "finding": {
      "type": "object",
      "required": ["localId", "category", "statement", "evidenceRefs", "confidence", "impact"],
      "additionalProperties": false,
      "properties": {
        "localId": {"$ref": "#/$defs/localId"},
        "category": {
          "enum": [
            "region",
            "component-family",
            "element",
            "collection",
            "runtime-field",
            "responsive-intent",
            "state",
            "asset-boundary",
            "explicit-requirement",
            "exclusion",
            "acceptance-criterion",
            "risk"
          ]
        },
        "statement": {"type": "string", "minLength": 1},
        "evidenceRefs": {"$ref": "#/$defs/localRefs"},
        "subjectRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,95}$"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "impact": {"enum": ["low", "medium", "high"]}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["localId", "sourceKey", "kind", "description", "confidence"],
      "additionalProperties": false,
      "properties": {
        "localId": {"$ref": "#/$defs/localId"},
        "sourceKey": {"type": "string", "pattern": "^source-[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["direct-observation", "user-statement", "cross-instance", "project-reference", "inference"]},
        "description": {"type": "string", "minLength": 1},
        "bounds": {"$ref": "#/$defs/bounds"},
        "sourceDimensions": {
          "type": "array",
          "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "pixelBounds": {"$ref": "#/$defs/pixelBounds"},
        "measurementMethod": {"enum": ["image-measurement", "editor-readback", "derived"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "question": {
      "type": "object",
      "required": ["localId", "question", "reason", "impact", "relatedFindingRefs"],
      "additionalProperties": false,
      "properties": {
        "localId": {"$ref": "#/$defs/localId"},
        "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "impact": {"enum": ["low", "medium", "high"]},
        "relatedFindingRefs": {"$ref": "#/$defs/localRefs"}
      }
    }
  }
}
