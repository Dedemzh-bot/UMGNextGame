{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextgame-ui:portable-workflow:2.0.0",
  "title": "NextGame UI portable multi-agent workflow",
  "description": "Vendor-neutral orchestration contract. Runtime messages are advisory; filesystem artifacts are authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRef",
    "contractVersion",
    "workflowId",
    "workflowVersion",
    "requestPacketRef",
    "artifactExchange",
    "agentDispatchPolicy",
    "requiredFindingsRoles",
    "parallelGroups",
    "steps",
    "requirementsTerminal",
    "protectedContinuation"
  ],
  "properties": {
    "schemaRef": {
      "const": "workflow.schema.json"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "workflowVersion": {
      "const": "2.0.0"
    },
    "requestPacketRef": {
      "$ref": "#/$defs/relativePath"
    },
    "artifactExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "messagesAreAuthoritative",
        "completionRule",
        "integrityAlgorithm",
        "failClosedOnMissingOrDigestMismatch",
        "provenanceRule",
        "compositeOutputs",
        "pathStyle",
        "allowedOutputPrefixes",
        "allowedRootOutputs"
      ],
      "properties": {
        "authority": {
          "const": "filesystem-artifacts"
        },
        "messagesAreAuthoritative": {
          "const": false
        },
        "completionRule": {
          "type": "string",
          "minLength": 1
        },
        "integrityAlgorithm": {
          "const": "sha256"
        },
        "failClosedOnMissingOrDigestMismatch": {
          "const": true
        },
        "provenanceRule": {
          "type": "string",
          "minLength": 1
        },
        "compositeOutputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/compositeOutput"
          }
        },
        "pathStyle": {
          "const": "artifact-root-relative-posix"
        },
        "allowedOutputPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "allowedRootOutputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*\\.json$"
          }
        }
      }
    },
    "agentDispatchPolicy": {
      "$ref": "#/$defs/agentDispatchPolicy"
    },
    "requiredFindingsRoles": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/findingsRole"
      }
    },
    "parallelGroups": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/parallelGroup"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "requirementsTerminal": {
      "type": "string",
      "minLength": 1
    },
    "protectedContinuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatchByDefault",
        "schedulerPolicy",
        "agentDispatchPolicy",
        "preMutationEvidenceContract",
        "description",
        "steps"
      ],
      "properties": {
        "dispatchByDefault": {
          "const": false
        },
        "schedulerPolicy": {
          "const": "manual-resume-after-verified-gate-artifact"
        },
        "agentDispatchPolicy": {
          "$ref": "#/$defs/buildAgentDispatchPolicy"
        },
        "preMutationEvidenceContract": {
          "$ref": "#/$defs/preMutationEvidenceContract"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  },
  "$defs": {
    "agentDispatchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptContract",
        "historyPolicy",
        "forkTurns",
        "inheritsConversation",
        "allowModelOverride",
        "allowReasoningOverride"
      ],
      "properties": {
        "promptContract": {"const": "packet-path-only"},
        "historyPolicy": {"const": "none"},
        "forkTurns": {"const": "none"},
        "inheritsConversation": {"const": false},
        "allowModelOverride": {"const": false},
        "allowReasoningOverride": {"const": false}
      }
    },
    "buildAgentDispatchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptContract",
        "historyPolicy",
        "forkTurns",
        "inheritsConversation",
        "allowModelOverride",
        "allowReasoningOverride"
      ],
      "properties": {
        "promptContract": {"const": "single-validated-artifact-path"},
        "historyPolicy": {"const": "none"},
        "forkTurns": {"const": "none"},
        "inheritsConversation": {"const": false},
        "allowModelOverride": {"const": false},
        "allowReasoningOverride": {"const": false}
      }
    },
    "preMutationEvidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "schemaRef",
        "toolRef",
        "generationMode",
        "revalidationMode",
        "requiredBeforeEditorMutation"
      ],
      "properties": {
        "artifact": {"const": "status/ui-build-plan.pre-mutation-valid.json"},
        "schemaRef": {"const": "build-plan-pre-mutation.schema.json"},
        "toolRef": {"const": "scripts/build_plan_evidence.py"},
        "generationMode": {"const": "generate-and-self-validate"},
        "revalidationMode": {"const": "--validate-only"},
        "requiredBeforeEditorMutation": {"const": true}
      }
    },
    "compositeOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerStep",
        "descriptor",
        "pathSelector",
        "digestSelector",
        "identitySelector",
        "coverageSelector",
        "allowedPathPrefix",
        "consumerStep",
        "validator",
        "nullPolicy",
        "requireRunRootContainment",
        "requireDigestMatch",
        "requireCompleteEnumeration"
      ],
      "properties": {
        "id": {"enum": ["planned-layout-specs", "deterministic-build-plans"]},
        "ownerStep": {"enum": ["plan-umg-build", "validate-build-plan"]},
        "descriptor": {"enum": ["ui-build-bundle.planned.json", "status/ui-build-plan.pre-mutation-valid.json"]},
        "pathSelector": {"enum": ["assets[].layoutSpecPath", "plans[].path"]},
        "digestSelector": {"enum": ["assets[].layoutSpecSha256", "plans[].sha256"]},
        "identitySelector": {"enum": ["assets[].id", "plans[].assetId"]},
        "coverageSelector": {"enum": ["assets[].id", "ui-build-bundle.planned.json:execution.buildOrderAssetIds"]},
        "allowedPathPrefix": {"enum": ["layouts/", "plans/"]},
        "consumerStep": {"enum": ["validate-build-plan", "build-verified-umg"]},
        "validator": {"enum": ["ui-layout-spec-0.2", "deterministic-mcp-build-plan"]},
        "nullPolicy": {"const": "only-reuse-only-assets"},
        "requireRunRootContainment": {"const": true},
        "requireDigestMatch": {"const": true},
        "requireCompleteEnumeration": {"const": true}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "findingsRole": {
      "type": "string",
      "enum": [
        "visual-structure",
        "text-requirements",
        "project-pattern",
        "state-modeling",
        "data-adaptation",
        "asset-decomposition",
        "state-visual-review",
        "schema-feasibility-review",
        "coverage-review"
      ]
    },
    "parallelGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "manualAdvance",
        "decisionArtifact",
        "acceptanceCondition"
      ],
      "properties": {
        "actor": {
          "const": "user"
        },
        "manualAdvance": {
          "const": true
        },
        "decisionArtifact": {
          "$ref": "#/$defs/relativePath"
        },
        "acceptanceCondition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "execution",
        "dependsOn",
        "inputs",
        "agentInputs",
        "outputs",
        "instruction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "validation",
            "findings",
            "normalization",
            "projection",
            "synthesis",
            "gate",
            "build",
            "readback",
            "presentation",
            "document"
          ]
        },
        "execution": {
          "type": "string",
          "enum": ["coordinator", "worker", "human"]
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "agentInputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "agentRole": {
          "$ref": "#/$defs/findingsRole"
        },
        "parallelGroup": {
          "type": "string",
          "minLength": 1
        },
        "contractValidator": {
          "type": "string",
          "enum": [
            "request-packet",
            "request-packet-and-discovery-role-packets",
            "agent-findings-batch",
            "normalized-context-and-focused-role-packets",
            "draft-and-review-role-packets",
            "requirement-spec-strict",
            "accepted-build-view",
            "planned-build-bundle-structure",
            "build-plan-pre-mutation",
            "build-bundle-final",
            "unreal-widget-readback",
            "ui-build-acceptance",
            "program-handoff",
            "document-verification"
          ]
        },
        "gate": {
          "$ref": "#/$defs/gate"
        }
      }
    }
  }
}
